# Secrets
.env

# Generated output — tailored resumes, job artifacts, and LLM caches (PII)
output/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Word/Office lock files (created while a doc is open)
~$*.docx

# OS
Thumbs.db
desktop.ini

templates/
data/

# A stray resume/export dropped at the repo root (e.g. an upload saved for debugging)
# must never be stageable, even by `git add -A`. Nested .docx/.pdf under data/ or
# templates/ are already covered by the rules above; this is root-only.
/*.docx
/*.pdf