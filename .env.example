# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for the default setup.
#
#   copy .env.example .env

# --------------------------------------------------------------------------------------
# Anthropic (the default backend)
# --------------------------------------------------------------------------------------

# Required unless every stage is routed to another provider via --model.
# https://console.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------------------
# Alternate backends  (see: python tailor.py --help)
# --------------------------------------------------------------------------------------
#
#   --model claude      all stages on Claude                (default)
#   --model hybrid      rank on Ollama, rewrite on Claude
#   --model ollama      all stages on Ollama
#   --model lmstudio    all stages on local LM Studio
#
# Nothing below needs setting to use Ollama Cloud: the daemon handles auth once you have
# run `ollama signin`, and the defaults already point at it.

# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma4:cloud

# LM Studio (Developer → Start Server). No API key. LMSTUDIO_MODEL must match the exact
# id shown in LM Studio for the loaded model — not an Ollama-style tag.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model

# Bearer token for a hosted OpenAI-compatible endpoint (Groq, OpenRouter, GLM, Kimi...).
# Leave unset for Ollama / LM Studio — local servers authenticate through the app, and some
# reject an Authorization header outright.
# LLM_API_KEY=

# How to ask for JSON on the OpenAI-compatible path.
#   prompt  (default) schema in the system prompt + response_format: json_object
#   schema            also send response_format: json_schema with a strict schema
#
# Keep "prompt" for Ollama. Measured against nemotron-3-super:cloud: it accepts
# json_schema and silently ignores it, answering HTTP 200 with markdown prose, and its
# native `format` parameter is equally unenforced. Sending the schema is a round trip that
# always fails. Use "schema" for endpoints that genuinely constrain decoding (OpenAI, vLLM).
# LLM_STRUCTURED_MODE=prompt

# Seconds to wait for one completion. Default 900 — local LM Studio rewrite of ~14
# bullets in one batch is slow; raise further if you still time out mid-rewrite.
# LLM_TIMEOUT=900

# --------------------------------------------------------------------------------------
# Paths and PDF backend (optional — defaults match a source checkout)
# --------------------------------------------------------------------------------------
#
# RESUME_TAILOR_DATA_DIR=
# RESUME_TAILOR_TEMPLATES_DIR=
# RESUME_TAILOR_OUTPUT_DIR=
# RESUME_TAILOR_CACHE_DIR=
# RESUME_TAILOR_PDF_BACKEND=auto   # word | soffice | auto
# SOFFICE_BINARY=soffice
# SOFFICE_TIMEOUT=120

# --------------------------------------------------------------------------------------
# Reasoning effort, per stage
# --------------------------------------------------------------------------------------
#
# This is where most of the money goes. The prompts here are small — the largest call
# sends ~2,800 input tokens — so at Sonnet rates a call should cost ~$0.03. It bills ~$0.16.
# The difference is reasoning tokens, drawn from MAX_TOKENS and billed as output.
#
# Extraction and scoring default to "low": neither is reasoning-hard. Rewriting keeps
# "medium" because that is the call where thinking shows up in the output.

# LLM_EFFORT_EXTRACT=low
# LLM_EFFORT_SCORE=low
# LLM_EFFORT_REWRITE=medium
