# Copy to .env and fill in. Nothing is required for the default setup — the default
# backend is `ollama`, which needs no key at all (see below).
#
#   copy .env.example .env

# --------------------------------------------------------------------------------------
# Anthropic (--model claude / hybrid)
# --------------------------------------------------------------------------------------

# Required only if you select --model claude, --model hybrid, or override a stage to an
# Anthropic model directly.
# https://console.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------------------
# Alternate backends  (see: python tailor.py --help)
# --------------------------------------------------------------------------------------
#
#   --model ollama      all stages on Ollama       (default — no key needed)
#   --model claude      all stages on Claude
#   --model gemini      all stages on Gemini
#   --model lmstudio    all stages on local LM Studio
#   --model hybrid      rank on Ollama, rewrite on Claude
#
# Nothing below needs setting to use Ollama Cloud via the local daemon: it handles auth
# once you have run `ollama signin`, and the defaults already point at it.

# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma4:cloud

# Backend for one-off web-UI actions that are not a tailoring run (currently just the
# import wizard's "suggest tags" pass). Independent of --model / the Run tab's Model
# dropdown — set this to reroute that one call without affecting tailoring runs at all.
# Defaults to "ollama", so it never bills a paid API by accident.
# ONE_OFF_PROFILE=ollama

# To skip installing Ollama entirely, call the cloud API directly instead (key from
# https://ollama.com/settings/keys — free plan works). Only the first two lines change;
# the model tag stays exactly as it is above.
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=

# LM Studio (Developer → Start Server). No API key. LMSTUDIO_MODEL must match the exact
# id shown in LM Studio for the loaded model — not an Ollama-style tag.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model

# Google Gemini, via its OpenAI-compatible endpoint. Unlike Ollama/LM Studio this one
# genuinely requires a key — get one at https://aistudio.google.com/apikey (free tier).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Bearer token for a hosted OpenAI-compatible endpoint (Groq, OpenRouter, GLM, Kimi...).
# Leave unset for Ollama / LM Studio — local servers authenticate through the app, and some
# reject an Authorization header outright. Also used as a Gemini fallback if
# GEMINI_API_KEY / GOOGLE_API_KEY are both unset.
# LLM_API_KEY=

# How to ask for JSON on the OpenAI-compatible path.
#   prompt  schema in the system prompt + response_format: json_object
#   schema  also send response_format: json_schema with a strict schema
#
# Left unset (the default), the mode is chosen per provider: "prompt" for Ollama/LM
# Studio — measured against nemotron-3-super:cloud, which accepts json_schema and
# silently ignores it, answering HTTP 200 with markdown prose — and "schema" for Gemini,
# whose endpoint genuinely constrains decoding. Setting this explicitly overrides that
# per-provider choice everywhere.
# LLM_STRUCTURED_MODE=

# Seconds to wait for one completion. Default 900 — local LM Studio rewrite of ~14
# bullets in one batch is slow; raise further if you still time out mid-rewrite.
# LLM_TIMEOUT=900

# Pins BOTH the starting request and the escalation ceiling for every OpenAI-compatible
# stage (Ollama/LM Studio/Gemini), overriding the adaptive per-provider caps
# (config.PROVIDER_MAX_TOKENS). Normally you do not need this: a response that truncates
# is retried automatically at a higher ceiling (up to the provider's cap) instead of
# failing outright. Set this only to force a specific number, e.g. while debugging a
# stage that is truncating anyway.
# LLM_MAX_TOKENS=

# --------------------------------------------------------------------------------------
# Paths and PDF backend (optional — defaults match a source checkout)
# --------------------------------------------------------------------------------------
#
# Each of these names a root; profiles ("workspaces") nest under it as
# <root>/workspaces/<id>/. Relocating a root moves every profile's storage with it —
# there is no separate per-profile override.
#
# RESUME_TAILOR_DATA_DIR=
# RESUME_TAILOR_TEMPLATES_DIR=
# RESUME_TAILOR_OUTPUT_DIR=
# RESUME_TAILOR_CACHE_DIR=
# RESUME_TAILOR_CALIBRATION_DIR=   # default: <RESUME_TAILOR_DATA_DIR>/calibration
# RESUME_TAILOR_PDF_BACKEND=auto   # word | soffice | auto
# SOFFICE_BINARY=soffice
# SOFFICE_TIMEOUT=120

# --------------------------------------------------------------------------------------
# Reasoning effort, per stage
# --------------------------------------------------------------------------------------
#
# This is where most of the money goes. The prompts here are small — the largest call
# sends ~2,800 input tokens — so at Sonnet rates a call should cost ~$0.03. It bills ~$0.16.
# The difference is reasoning tokens, drawn from MAX_TOKENS and billed as output.
#
# Extraction and scoring default to "low": neither is reasoning-hard. Rewriting keeps
# "medium" because that is the call where thinking shows up in the output.

# LLM_EFFORT_EXTRACT=low
# LLM_EFFORT_SCORE=low
# LLM_EFFORT_REWRITE=medium
