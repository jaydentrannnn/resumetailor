    {
      "id": "adzuna-finance-intern",
      "name": "Adzuna search: finance internships",
      "description": "Keyword search for banking, finance and accounting internships. Needs free Adzuna API keys (connect them once on this page).",
      "fields": [
        "finance"
      ],
      "levels": [
        "intern"
      ],
      "tracks": [
        "banking",
        "accounting",
        "corp_finance"
      ],
      "version": "2026.10.08",
      "template": {
        "id": "adzuna-finance-intern",
        "kind": "job_search",
        "provider": "adzuna",
        "query": "investment banking analyst intern, financial analyst intern, audit associate intern, m&a analyst intern, finance analyst intern",
        "include": [
          "intern",
          "summer analyst",
          "summer associate"
        ],
        "exclude": [
          "senior",
          "sr",
          "principal",
          "director",
          "vice president",
          "vp",
          "managing director",
          "head of",
          "chief"
        ]
      }
    },
    {
      "id": "adzuna-finance-newgrad",
      "name": "Adzuna search: finance entry level",
      "description": "Keyword search for entry-level banking, finance and accounting roles. Entry titles such as Analyst carry no level word, so only senior titles are skipped. Needs free Adzuna API keys (connect them once on this page).",
      "fields": [
        "finance"
      ],
      "levels": [
        "new_grad"
      ],
      "tracks": [
        "banking",
        "accounting",
        "corp_finance"
      ],
      "version": "2026.10.08",
      "template": {
        "id": "adzuna-finance-newgrad",
        "kind": "job_search",
        "provider": "adzuna",
        "query": "entry level investment banking analyst, entry level financial analyst, entry level audit associate, entry level m&a analyst, entry level finance analyst",
        "include": [],
        "exclude": [
          "senior",
          "sr",
          "principal",
          "director",
          "vice president",
          "vp",
          "managing director",
          "head of",
          "chief"
        ]
      }
    },
    {
      "id": "adzuna-consulting-intern",
      "name": "Adzuna search: consulting internships",
      "description": "Keyword search for strategy, technology and business-analyst consulting internships. Needs free Adzuna API keys (connect them once on this page).",
