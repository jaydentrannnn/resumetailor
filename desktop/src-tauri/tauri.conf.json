{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResumeTailor",
  "version": "0.1.0",
  "identifier": "app.resumetailor.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ResumeTailor",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/resumetailor-server/": "server/"
    },
    "category": "Productivity",
    "shortDescription": "Tailor your resume to a job without changing its look",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Jayden Tran"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MzRDMTY2RjZCRTRGQTgKUldTb1Q3NzJac0UwdE8xcUJBalRJbnhOM2l6bnM5c29Cck5INnA2VWJBQmxOWmtJVTVUL3dpQWoK",
      "endpoints": [
        "https://github.com/jaydentrannnn/resumetailor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
